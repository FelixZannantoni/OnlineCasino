@startuml
skinparam classAttributeIconSize 0

interface Card {
  +name: string
  +value: number
  +color: string
  +owner: string
}

enum CardColor {
  HEARTS = "HEARTS"
  DIAMONDS = "DIAMONDS"
  CLUBS = "CLUBS"
  SPADES = "SPADES"
}

enum CardName {
  two = "two"
  three = "three"
  four = "four"
  five = "five"
  six = "six"
  seven = "seven"
  eight = "eight"
  nine = "nine"
  ten = "ten"
  jack = "jack"
  queen = "queen"
  king = "king"
  ace = "ace"
}

class Game<T extends Player = Player> {
  #players: T[]
  +Game()
  +addPlayer(player: T): void
  +getPlayers(): T[]
}

class CardGame<T extends CardGamePlayer = CardGamePlayer> {
  +CardGame()
  #setDealerChip(): void
  #updateDealerChip(): void
}

class Poker {
  {static} +MAX_PLAYER_COUNT: number = 5
  {static} +PLAYER_CARDS_NUMBER: number = 2
  {static} +POKER_CARDS_NUMBER: number = 5
  {static} +POKER_DESK_ID: string = "PokerDesk"
  -pokerDeck: PokerDeck
  -pokerDeskCards: Card[]
  -defaultbet: number = 10
  -currentBet: number
  -pot: number = 0
  +Poker()
  -startGame(): void
  -nextRound(): void
  -handCardsOut(): void
  -resetCards(): void
  #resetBets(): void
  #setDeafaultBets(): void
  -makeMove(): void
  -playRound(): void
}

class Blackjack {
  +Blackjack()
}

class Player {
  -playerId: string
  -username: string
  -displayname: string
  -balance: number
  -bet: number
  +Player(playerId: string, username: string, \n  displayname: string, balance: number, bet: number)
  +getPlayerId(): string
  +getUsername(): string
  +getDisplayname(): string
  +getBalance(): number
  +getBet(): number
  +setBet(bet: number): void
  {static} +xNextPlayer(players: Player[], i: number, x: number): number
  {static} +nextPlayer(players: Player[], i: number): number
}

class CardGamePlayer {
  -cards: Card[]
  -hasDealerChip: boolean
  +CardGamePlayer(playerId: string, username: string, \n  displayname: string, balance: number, \n  hasDealerChip: boolean, bet: number)
  +getCards(): Card[]
  +getDealerChip(): boolean
  +setDealerChip(hasDealerChip: boolean): void
  +addCard(card: Card, playerId: string): void
  +clearHand(): void
  {static} +playerWithDealerChip(players: CardGamePlayer[]): number
}

class PokerPlayer {
  -pressedFold: boolean = false
  -pressedCheck: boolean = false
  -pressedBet: boolean = false
  -pressedCall: boolean = false
  -pressedRaise: boolean = false
  +PokerPlayer(playerId: string, username: string, \n  displayname: string, balance: number, \n  hasDealerChip: boolean, bet: number)
  +getPressedFold(): boolean
  +getPressedCheck(): boolean
  +getPressedBet(): boolean
  +getPressedCall(): boolean
  +getPressedRaise(): boolean
}

class BlackjackPlayer {
  +BlackjackPlayer(playerId: string, username: string, \n  displayname: string, balance: number, \n  hasDealerChip: boolean, bet: number)
}

class Deck {
  {static} +DEALER_ID: string = "Dealer"
  #deck: Card[]
  +Deck()
  #shuffle(cardDeck: Card[]): void
  +dealCard(cardDeck: Card[], id: string): Card
  +getDeck(): Card[]
}

class BlackjackDeck {
  -blackjackCardValue: Map<CardName, number>
  +BlackjackDeck()
  -blackjackDeckInit(): void
}

class PokerDeck {
  -pokerCardValue: Map<CardName, number>
  +PokerDeck()
  -pokerDeckInit(): void
}

' Inheritance
Game <|-- CardGame
CardGame <|-- Poker
CardGame <|-- Blackjack
Deck <|-- BlackjackDeck
Deck <|-- PokerDeck
Player <|-- CardGamePlayer
CardGamePlayer <|-- PokerPlayer
CardGamePlayer <|-- BlackjackPlayer

' Associations
Game o-- "many" Player : contains
Poker *-- "many" Card : pokerDeskCards
CardGamePlayer *-- "many" Card : cards
Deck *-- "many" Card : deck
Poker o-- "1" PokerDeck : uses
Blackjack o-- "1" BlackjackDeck : uses

@enduml
